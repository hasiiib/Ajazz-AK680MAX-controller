# Grant the active desktop user access only to the AK680 MAX vendor Feature interface.
# The matching USB properties and interface number were verified on hidraw4.
SUBSYSTEM=="hidraw", ENV{ID_BUS}=="usb", ENV{ID_USB_VENDOR_ID}=="3151", ENV{ID_USB_MODEL_ID}=="502d", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="uaccess"
